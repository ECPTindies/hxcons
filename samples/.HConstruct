class ExampleProject extends HConstruct
{
    public function new()
    {
        super();

        setApplyTitle("MyApp");
        setApplyVersion("0.1.0");
        setSrcMainClass("samples.src.Main");
        addSourceDir("src");
        addSourceDir("shared");

        setDebug(true);
        addDefine("MY_FEATURE");

        var sdlInclude = Sys.getEnv("SDL2_INCLUDE");
        var sdlLibPath = Sys.getEnv("SDL2_LIBPATH");

        if (sdlInclude != null) addInclude(sdlInclude);
        if (sdlLibPath != null) addLibPath(sdlLibPath);
        addLib("SDL2");
    }
}