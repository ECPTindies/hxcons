class ExampleProject extends HConstruct
{
    public function new()
    {
        super();

        /**
         * Apply Title
         * ex: [MyApp.exe]
         */
        setApplyTitle("MyApp");

        /**
         * Apply Version
         */
        setApplyVersion("0.1.0");

        setSrcMainClass("samples.src.Main");
        addSourceDir("src");
        addSourceDir("shared"); // 複数フォルダのテスト用

        addAsset({ path: "assets", rename: null, include: ["*"], embed: true });

        setExportDir("out");
        setCompiler("auto");
        setDebug(true);

        addInclude("extra/include");
        addLibPath("third_party/sdl2/lib");
        addLib("SDL2");

        addDefine("MY_FEATURE");
    }
}