class ExampleProject extends HxConstruct
{
    public function new()
    {
        super();

        setApplyTitle("MyApp");
        setApplyVersion("0.1.0");
        setSrcMainClass("samples.window.src.Main");
        addSourceDir("src");
        addSourceDir("shared");

        addAsset({ path: "assets" });

        setDebug(false);
        setConsole(false);
        setDefine({ id: "MY_FEATURE" });
        setDefine({ id: "MY_FEATURE_2", value: 2 });
        addDefine("MY_FEATURE_3");

        var sdlInclude = Sys.getEnv("SDL2_INCLUDE");
        var sdlLibPath = Sys.getEnv("SDL2_LIBPATH");

        if (sdlInclude != null) addInclude(sdlInclude);
        if (sdlLibPath != null) addLibPath(sdlLibPath);
        addLib("SDL2");
    }
}